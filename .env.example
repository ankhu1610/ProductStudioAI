# Copy this file to .env before running the ProductStudio application.

# Model and runtime
PRODUCTSTUDIO_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-inpainting
PRODUCTSTUDIO_MODEL_PATH=
PRODUCTSTUDIO_DEVICE=cuda
PRODUCTSTUDIO_PRECISION=fp16

# Generation defaults
PRODUCTSTUDIO_OUTPUT_DIR=outputs
PRODUCTSTUDIO_DEFAULT_WIDTH=512
PRODUCTSTUDIO_DEFAULT_HEIGHT=512
PRODUCTSTUDIO_DEFAULT_STEPS=15
PRODUCTSTUDIO_DEFAULT_GUIDANCE_SCALE=7.5
PRODUCTSTUDIO_MAX_VARIANTS=4

# Local services (used in later phases)
PRODUCTSTUDIO_DATABASE_URL=sqlite:///productstudio.db
PRODUCTSTUDIO_MLFLOW_TRACKING_URI=mlruns

